{
  "format": 1,
  "id": "exemplo-d20",
  "name": "Sistema de Exemplo (d20 simples)",
  "version": "1.0.0",
  "author": "GabrielGugg",
  "license": "MIT",
  "language": "pt-BR",
  "type": "system",
  "description": "Um sistema pequeno, no estilo d20, para testar o app e servir de modelo para quem quiser criar o seu.",
  "rolls": {
    "modifier": "floor((value - 10) / 2)",
    "default": "1d20"
  },
  "progression": {
    "max_level": 20,
    "xp_per_level": "level * 1000"
  },
  "attributes": [
    {
      "id": "FOR",
      "name": "Força",
      "min": 1,
      "max": 20,
      "default": 10
    },
    {
      "id": "DES",
      "name": "Destreza",
      "min": 1,
      "max": 20,
      "default": 10
    },
    {
      "id": "CON",
      "name": "Constituição",
      "min": 1,
      "max": 20,
      "default": 10
    },
    {
      "id": "INT",
      "name": "Inteligência",
      "min": 1,
      "max": 20,
      "default": 10
    },
    {
      "id": "SAB",
      "name": "Sabedoria",
      "min": 1,
      "max": 20,
      "default": 10
    },
    {
      "id": "CAR",
      "name": "Carisma",
      "min": 1,
      "max": 20,
      "default": 10
    }
  ],
  "skills": [
    {
      "id": "atletismo",
      "name": "Atletismo",
      "attribute": "FOR",
      "description": "Escalar, nadar, saltar."
    },
    {
      "id": "furtividade",
      "name": "Furtividade",
      "attribute": "DES",
      "description": "Passar sem ser notado."
    },
    {
      "id": "percepcao",
      "name": "Percepção",
      "attribute": "SAB",
      "description": "Notar o que está escondido."
    },
    {
      "id": "persuasao",
      "name": "Persuasão",
      "attribute": "CAR",
      "description": "Convencer com palavras."
    }
  ],
  "derived": [
    {
      "id": "proficiencia",
      "name": "Bônus de Proficiência",
      "formula": "floor((level - 1) / 4) + 2"
    },
    {
      "id": "ca",
      "name": "Classe de Armadura",
      "formula": "10 + mod(DES)"
    },
    {
      "id": "iniciativa",
      "name": "Iniciativa",
      "formula": "mod(DES)"
    },
    {
      "id": "carga",
      "name": "Carga",
      "formula": "sum('armas', 'peso') + sum('armaduras', 'peso') + sum('equipamentos', 'peso')",
      "unit": "kg"
    },
    {
      "id": "carga_max",
      "name": "Carga Máxima",
      "formula": "FOR * 7",
      "unit": "kg"
    }
  ],
  "resources": [
    {
      "id": "pv",
      "name": "Pontos de Vida",
      "max": "8 + mod(CON) + (level - 1) * (5 + mod(CON))",
      "recovery": "Descanso longo: todos."
    },
    {
      "id": "inspiracao",
      "name": "Inspiração",
      "max": "1"
    }
  ],
  "counters": [
    {
      "id": "exaustao",
      "name": "Exaustão",
      "max": 6,
      "description": "−2 por nível em testes de d20. No 6º nível, você morre.",
      "effects": [
        {
          "type": "add",
          "target": "iniciativa",
          "value": "-2 * n"
        },
        {
          "type": "note",
          "text": "Exaustão: −2 por nível em testes de d20."
        }
      ]
    }
  ],
  "collections": {
    "classes": {
      "name": "Classe",
      "max": 1,
      "fields": {
        "dado_vida": {
          "type": "text",
          "label": "Dado de Vida"
        }
      }
    },
    "tracos": {
      "name": "Traços",
      "fields": {}
    },
    "armas": {
      "name": "Armas",
      "equippable": true,
      "quantity": true,
      "fields": {
        "dano": {
          "type": "dice",
          "label": "Dano"
        },
        "propriedades": {
          "type": "text",
          "label": "Propriedades"
        },
        "custo": {
          "type": "number",
          "label": "Custo",
          "unit": "po"
        },
        "peso": {
          "type": "number",
          "label": "Peso",
          "unit": "kg"
        }
      }
    },
    "armaduras": {
      "name": "Armaduras",
      "equippable": true,
      "fields": {
        "custo": {
          "type": "number",
          "label": "Custo",
          "unit": "po"
        },
        "peso": {
          "type": "number",
          "label": "Peso",
          "unit": "kg"
        }
      }
