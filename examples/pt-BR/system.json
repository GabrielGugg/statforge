    "pocoes": {
      "name": "Poções",
      "quantity": true,
      "fields": {
        "custo": {
          "type": "number",
          "label": "Custo",
          "unit": "po"
        }
      }
    },
    "equipamentos": {
      "name": "Equipamento",
      "quantity": true,
      "fields": {
        "peso": {
          "type": "number",
          "label": "Peso",
          "unit": "kg"
        }
      }
    },
    "condicoes": {
      "name": "Condições",
      "fields": {}
    }
  },
  "entities": {
    "classes": [
      {
        "id": "guerreiro",
        "name": "Guerreiro",
        "dado_vida": "d10",
        "description": "Mestre das armas.",
        "effects": [
          {
            "type": "add",
            "target": "pv",
            "value": "2 * level"
          }
        ]
      },
      {
        "id": "ladino",
        "name": "Ladino",
        "dado_vida": "d8",
        "description": "Furtivo e preciso.",
        "effects": [
          {
            "type": "add",
            "target": "furtividade",
            "value": "proficiencia"
          }
        ]
      }
    ],
    "tracos": [
      {
        "id": "robusto",
        "name": "Robusto",
        "description": "+1 PV por nível.",
        "effects": [
          {
            "type": "add",
            "target": "pv",
            "value": "level"
          }
        ]
      },
      {
        "id": "constructo",
        "name": "Constructo",
        "description": "Seu corpo é de pedra e engrenagens. Poções não fazem efeito, e você é imune a veneno.",
